{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/generated/*.ts",
    "src/features/review/keymap.ts",
    "src/features/review/tree.ts",
    "src/features/review/editor/sectionLayout.ts",
    "scripts/*.mjs",
    "test/harness/*.mjs",
    "*.js",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
